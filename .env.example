# Base URL for the student data API. Services fall back to mock data when unset.
VITE_API_BASE_URL=https://api.example.umn.edu/v1

# Supabase project base URL (no /rest/v1) and its publishable key
# (Supabase → Project Settings → API Keys). Both are safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Claude API key (server-only — no VITE_ prefix, so it never reaches the browser).
# Create one at https://platform.claude.com → Settings → API Keys.
ANTHROPIC_API_KEY=

# Canvas LMS personal access token (Canvas → Account → Settings → New access token). Server-only.
CANVAS_BASE_URL=https://canvas.umn.edu
CANVAS_API_TOKEN=
