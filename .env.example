# Base URL for the student data API. Services fall back to mock data when unset.
VITE_API_BASE_URL=https://api.example.umn.edu/v1

# Supabase project base URL (no /rest/v1) and its publishable key
# (Supabase → Project Settings → API Keys). Both are safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
